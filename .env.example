# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=brifnet_isp_core

# BrifNet M-Pesa Gateway
#
# Development/testing may use a Cloudflare Tunnel.
BRIFNET_MPESA_GATEWAY_URL=

# Gateway HTTP timeout in milliseconds.
BRIFNET_MPESA_TIMEOUT_MS=10000

# Optional.
# Leave empty until gateway authentication is enabled.
BRIFNET_MPESA_ACCESS_TOKEN=

# Required by the ISP Core for webhook signature verification.
BRIFNET_MPESA_WEBHOOK_SECRET=